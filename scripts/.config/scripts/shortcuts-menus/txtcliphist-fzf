#!/usr/bin/env bash
# Text clipboard history picker using fzf + cliphist

set -euo pipefail
export DISPLAY="${DISPLAY:-:0}"

run_picker() {
    local selection=""

    selection="$(cliphist list 2>/dev/null | fzf -m \
        --prompt="Text > " \
        --layout=reverse \
        --border \
        --info=inline \
        --header="tab: toggle-select | enter: copy | ctrl-d: delete multi | ctrl-r: refresh" \
        --bind 'tab:toggle' \
        --bind 'ctrl-d:execute-silent(printf "%s\n" {+} | while IFS= read -r line; do printf "%s\n" "$line" | cliphist delete; done)+reload(cliphist list)' \
        --bind 'ctrl-r:reload(cliphist list)' \
        --preview 'printf "%s\n" {} | cliphist decode 2>/dev/null' \
        --preview-window='right:60%:wrap'
    )" || return 0

    [[ -z "$selection" ]] && return 0

    if printf "%s\n" "$selection" | cliphist decode 2>/dev/null | xclip -selection clipboard 2>/dev/null; then
        notify-send --urgency=low "Clipboard" "Copied selection" 2>/dev/null || true
    fi
}

launch_picker() {
    st -f 'Liberation Mono:pixelsize=14' -c fzfmenu -n fzfmenu -T fzf \
       -g "107x25+100+270" \
       -e bash -lc "~/.config/scripts/shortcuts-menus/txtcliphist-fzf pick"
}

case "${1:-sel}" in
    pick)
        run_picker
        ;;
    sel|*)
        launch_picker
        ;;
esac
