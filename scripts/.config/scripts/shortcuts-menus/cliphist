#!/usr/bin/env bash
# Cliphist simple dmenu picker for X11
# Optimized for performance

export DISPLAY="${DISPLAY:-:0}"

# Cache dmenu colors to avoid repeated calls
if [[ -z "$DMENU_COLORS" ]]; then
    DMENU_COLORS=$(/home/croc/dotfiles/scripts/.config/scripts/helpers/dmenu-colors)
fi

# Check what clipboard history types are available
has_text=false
[[ -n "$(cliphist list 2>/dev/null)" ]] && has_text=true

HIST_DIR=~/.cache/hist
has_images=false
[[ -d "$HIST_DIR" ]] && [[ -n "$(ls -A "$HIST_DIR"/*.png 2>/dev/null)" ]] && has_images=true

FILEHIST=~/.cache/filehist/log
has_files=false
[[ -f "$FILEHIST" ]] && [[ -s "$FILEHIST" ]] && has_files=true

# Build menu and count items
menu=""
count=0
$has_text   && menu="${menu}Text\n"   && ((count++))
$has_images && menu="${menu}Images\n" && ((count++))
$has_files  && menu="${menu}Files\n"  && ((count++))

if [[ $count -eq 0 ]]; then
    notify-send --urgency=low "Clipboard" "No clipboard history yet"
    exit 0
fi

# If multiple types, show dmenu choice; otherwise auto-select
if [[ $count -gt 1 ]]; then
    choice=$(printf "$menu" | dmenu $DMENU_COLORS -c -l "$count" -p "Clipboard:" -i -fn "Iosevka Nerd Font:size=10")
else
    choice=$(printf "$menu" | head -1 | sed 's/\\n//')
fi

case "$choice" in
    Text)
        ~/.config/scripts/shortcuts-menus/txtcliphist-fzf sel &
        ;;
    Images)
        ~/.config/scripts/images-photos-wallpapers/imgcliphist sel &
        ;;
    Files)
        ~/.config/scripts/shortcuts-menus/filecliphist sel &
        ;;
esac
