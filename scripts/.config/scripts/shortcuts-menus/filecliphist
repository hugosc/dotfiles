#!/usr/bin/env bash
# File clipboard history picker
# Shows recently copied file paths and copies them as text/uri-list.
# Notifications handled by clipboard-monitor.

export DISPLAY=:0

FILEHIST="$HOME/.cache/filehist/log"

run_picker() {
    [[ ! -f "$FILEHIST" ]] && return 0

    local selection
    selection="$(tac "$FILEHIST" 2>/dev/null | nl -w 1 -s '  ' | \
        fzf -m \
            --prompt="Files > " \
            --layout=reverse \
            --border \
            --info=inline \
            --header="tab: toggle | shift-↑↓: range | ctrl-a: all | enter: copy | ctrl-d: delete multi | ctrl-r: refresh" \
            --bind 'tab:toggle' \
            --bind 'shift-up:toggle+up' \
            --bind 'shift-down:toggle+down' \
            --bind 'ctrl-a:select-all' \
            --bind 'ctrl-d:execute-silent(echo {2..} | while IFS= read -r p; do sed -i "\|^$p$|d" "$FILEHIST" 2>/dev/null; done)' \
            --bind 'ctrl-r:reload(tac "$FILEHIST" | nl -w 1 -s "  ")' \
            --preview 'file --dereference --brief {2..} 2>/dev/null; echo; ls -lh {2..} 2>/dev/null | awk "{print \$5}"' \
            --preview-window='right:40:wrap'
    )" || return 0

    [[ -z "$selection" ]] && return 0

    local uris=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local path
        path=$(echo "$line" | sed 's/^[[:space:]]*[0-9]*[[:space:]]*//')
        [[ -z "$path" ]] && continue
        local uri
        # Percent-encode special chars for file:// URI
        local encoded
        encoded=$(printf "%s" "$path" | sed 's/%/%25/g; s/ /%20/g; s/"/%22/g; s/'"'"'/%27/g; s/#/%23/g; s/?/%3F/g; s/&/%26/g; s/=/%3D/g; s/+/%2B/g; s/,/%2C/g; s/;/%3B/g; s/:/%3A/g; s/@/%40/g; s/!/%21/g; s/\*/%2A/g; s/(/%28/g; s/)/%29/g; s/\[/%5B/g; s/\]/%5D/g; s/{/%7B/g; s/}/%7D/g; s/\$/%24/g; s/\^/%5E/g; s/`/%60/g; s/|/%7C/g; s/\\/%5C/g')
        uri="file://$encoded"
        uris+="$uri"$'\n'
    done <<< "$selection"

    [[ -z "$uris" ]] && return 0

    printf "%s" "$uris" | nohup xclip -selection clipboard -t text/uri-list >/dev/null 2>&1 &
}

launch_picker() {
    st -f 'Liberation Mono:pixelsize=14' -c fzfmenu -n fzfmenu -T fzf \
       -g "107x25+100+270" \
       -e /home/croc/.config/scripts/shortcuts-menus/filecliphist pick
}

case "${1:-sel}" in
    pick)
        run_picker
        ;;
    sel|*)
        launch_picker
        ;;
esac
