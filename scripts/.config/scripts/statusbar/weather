#!/bin/sh

# Weather script for dwmblocks using wttr.in
# Caches result for 20 minutes to avoid excessive API calls

CACHE_FILE="/tmp/dwmblocks_weather_cache"
CACHE_AGE=1200  # 20 minutes in seconds

TERMINAL=${TERMINAL:-st}

# Check if cache exists and is fresh
if [ -f "$CACHE_FILE" ]; then
    CURRENT_TIME=$(date +%s)
    FILE_TIME=$(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)
    AGE=$((CURRENT_TIME - FILE_TIME))
    
    if [ $AGE -lt $CACHE_AGE ]; then
        cat "$CACHE_FILE"
        exit 0
    fi
fi

# Fetch weather data (single request)
WEATHER=$(curl -fsS --max-time 3 "https://wttr.in/?format=%t+%C" 2>/dev/null)

if [ -z "$WEATHER" ]; then
    # If fetch fails, keep last known value if available
    if [ -f "$CACHE_FILE" ]; then
        cat "$CACHE_FILE"
        exit 0
    fi
    echo "N/A"
    exit 0
fi

# Remove + sign from temperature
WEATHER=$(echo "$WEATHER" | sed 's/+//')
PARSED=$(echo "$WEATHER" | tr '+' ' ')

# Cache the result
echo "$PARSED" > "$CACHE_FILE" 2>/dev/null

echo "$PARSED"

case $BLOCK_BUTTON in
    1) setsid -f "$TERMINAL" -e sh -c "curl -s https://wttr.in/ | less -R" ;;
esac
