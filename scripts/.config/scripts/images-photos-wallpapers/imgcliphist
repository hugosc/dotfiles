#!/usr/bin/env bash
# Image clipboard history using fzfub

HIST_DIR=~/.cache/hist

# Ensure hist directory exists
mkdir -p "$HIST_DIR"

case "$1" in
    add)
        # Add copied image to history
        if xclip -selection clipboard -o -t targets 2>/dev/null | grep -q png; then
            xclip -selection clipboard -t image/png -o > "$HIST_DIR/$(date '+%a_%b%d%y_%H%M%S').png" && \
            notify-send -i "$HIST_DIR/$(ls -t "$HIST_DIR" | head -n 1)" "📎 clipped img"
        fi
        ;;
    sel|*)
        # Select from clipboard history
        # Using fzfub with custom bindings for clipboard mode
        st -f 'Liberation Mono:pixelsize=14' -c fzfmenu -n fzfmenu -T fzf \
           -g "107x25+100+270" \
           -e bash -c "cat ~/.cache/wal/sequences 2>/dev/null; fzfub $HIST_DIR c --tac"
        ;;
esac
