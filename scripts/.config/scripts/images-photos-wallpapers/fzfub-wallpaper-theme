#!/usr/bin/env bash
# Apply a preset theme WITHOUT changing the wallpaper
# Called by Ctrl+T in wallpaper menu

# Show theme picker dmenu
theme=$(~/.config/scripts/images-photos-wallpapers/wallpaper-theme-picker)

# If user cancelled, exit
if [[ -z "$theme" ]]; then
    exit 0
fi

# Apply the theme to the current setup (NO wallpaper change)
# Use a dummy argument to trigger the theme-only case in fzfub-wallpapermenu
fzfub-wallpapermenu "theme-only" "$theme"
