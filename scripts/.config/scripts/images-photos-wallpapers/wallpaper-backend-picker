#!/usr/bin/env bash

# Show centered dmenu with all available pywal backends
# Returns selected backend name or exits if cancelled

# Get dmenu colors
DMENU_COLORS=$(/home/croc/dotfiles/scripts/.config/scripts/helpers/dmenu-colors)

# Get all available backends from pywal
backends=$(wal --backend 2>&1 | grep '^ -' | sed 's/^ - //' | sort)

# Show centered dmenu for backend selection
selected=$(echo "$backends" | dmenu $DMENU_COLORS -c -i -l 10 -p "Select Backend:" -fn "Iosevka Nerd Font:size=10")

# If user cancels or selects nothing, exit
if [[ -z "$selected" ]]; then
    exit 1
fi

# Return the selected backend
echo "$selected"
