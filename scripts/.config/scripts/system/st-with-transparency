#!/bin/bash
# ST launcher with transparency state inheritance (optimized)

STATE_FILE="/tmp/transparency-state"

# Initialize state only if missing (single check)
if [ ! -f "$STATE_FILE" ]; then
    PERSISTENT="$HOME/.cache/transparency-state"
    if [ -f "$PERSISTENT" ]; then
        cp "$PERSISTENT" "$STATE_FILE"
    else
        echo "transparent" | tee "$STATE_FILE" "$PERSISTENT" > /dev/null
    fi
fi

# Read state and launch (single file read, single conditional)
[ "$(cat "$STATE_FILE")" = "opaque" ] && exec st -A 1.0 "$@" || exec st -A 0.85 "$@"
