#!/bin/sh
# wmdinfo is a Window Maker dockapp; only run it under Window Maker (not dwm).
pgrep -x wmaker >/dev/null 2>&1 || exit 0
# If wmdinfo is not present/runnable, notify once so the user knows the panel is missing.
if ! command -v wmdinfo >/dev/null 2>&1; then
  notify-send -u low -t 5000 "wmdinfo" "wmdinfo dockapp not installed; panel unavailable." 2>/dev/null
  exit 0
fi
exec wmdinfo -c /home/croc/.config/scripts/system/wminfo-custom -u 120
