#!/bin/bash

STATE_FILE="/tmp/transparency-state"
PERSISTENT_STATE="$HOME/.cache/transparency-state"

[ ! -f "$STATE_FILE" ] && ~/.config/scripts/system/init-transparency-state

current_state=$(<"$STATE_FILE")

if [ "$current_state" = "transparent" ]; then
  new_state="opaque"
  emacs_alpha=100
else
  new_state="transparent"
  emacs_alpha=85
fi

printf '%s\n' "$new_state" > "$STATE_FILE"
printf '%s\n' "$new_state" > "$PERSISTENT_STATE"

emacsclient -e "(dolist (frame (frame-list)) (set-frame-parameter frame 'alpha-background $emacs_alpha))" &>/dev/null &

pkill -USR1 '^st$' &>/dev/null &

# Signal dwm to update bar transparency on next event loop iteration
dwm_pid=$(pidof dwm)
if [ -n "$dwm_pid" ]; then
  kill -USR1 "$dwm_pid" &>/dev/null
fi

wait
