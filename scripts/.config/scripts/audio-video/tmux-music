#!/bin/sh
# Launch or attach to music player in dedicated tmux session
# With floating window support (top-right corner)

export DISPLAY=:0
SESSION_NAME="music"

# Window geometry
# DWM will enforce floating via a rule on WM_CLASS "music".
# Size/position is done via xdotool so it stays consistent.
# Current preferred geometry (captured from your resized window)
WIN_W=284
WIN_H=256
WIN_X=1634
WIN_Y=20
GEOM="80x24"  # initial size; will be resized/repositioned by xdotool

# This script only ensures the tmux session exists and opens a
# dedicated st window with WM_CLASS "music" for dwm rules/scratchpad.

ensure_session() {
    if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
        return 0
    fi
    tmux new-session -d -s "$SESSION_NAME" ncspot
}

position_music_window() {
    # After spawn, force exact position/size.
    # This can race with dwm managing the new window, so retry.
    i=0
    while [ $i -lt 30 ]; do
        WID=$(xdotool search --onlyvisible --class music 2>/dev/null | head -n 1)
        if [ -n "$WID" ]; then
            xdotool windowsize "$WID" "$WIN_W" "$WIN_H"
            xdotool windowmove "$WID" "$WIN_X" "$WIN_Y"
            # Confirm it stuck (avoid single lucky run)
            GEO=$(xdotool getwindowgeometry --shell "$WID" 2>/dev/null)
            eval "$GEO"
            if [ "$WIDTH" = "$WIN_W" ] && [ "$HEIGHT" = "$WIN_H" ] && [ "$X" = "$WIN_X" ] && [ "$Y" = "$WIN_Y" ]; then
                xdotool windowraise "$WID"
                return 0
            fi
        fi
        i=$((i + 1))
        sleep 0.05
    done
    return 1
}

# Check if we're already inside a tmux session
if [ -n "$TMUX" ]; then
    ensure_session
    tmux switch-client -t "$SESSION_NAME"
    exit 0
fi

# Not inside tmux: just ensure it's running and (re)spawn the window.
# Showing/hiding is handled by dwm via `togglescratch("music")`.
ensure_session

# If a window is already visible, just snap geometry.
if position_music_window; then
    exit 0
fi

st -c music -n music -g "$GEOM" -e tmux attach-session -t "$SESSION_NAME" &
position_music_window
