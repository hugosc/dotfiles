#!/usr/bin/env bash
# Clean clipboard monitor for X11
# - Text goes to cliphist
# - Images go to ~/.cache/hist/

set -euo pipefail
export DISPLAY="${DISPLAY:-:0}"

# Ensure tools exist
command -v cliphist >/dev/null 2>&1 || { echo "cliphist not found" >&2; exit 1; }
command -v xclip >/dev/null 2>&1 || { echo "xclip not found" >&2; exit 1; }

# Image history directory
HIST_DIR=~/.cache/hist
mkdir -p "$HIST_DIR" 2>/dev/null || true

# Track last stored content to prevent duplicates
last_stored_hash=""

# Store clipboard content
store_clipboard() {
    local cur_hash=""
    
    # Check if clipboard contains file URIs (skip these - they're for drag-and-drop)
    if timeout 2 xclip -selection clipboard -t TARGETS -o 2>/dev/null | grep -qi "text/uri-list"; then
        return
    fi
    
    # Check if clipboard contains an image
    if timeout 2 xclip -selection clipboard -t TARGETS -o 2>/dev/null | grep -qi "image/png"; then
        # Handle image
        local tmp=$(mktemp --suffix=.png)
        
        if timeout 2 xclip -selection clipboard -t image/png -o >"$tmp" 2>/dev/null; then
            # Verify it's a valid PNG file using file command
            if ! file "$tmp" 2>/dev/null | grep -q "PNG image data"; then
                # Not a real PNG image
                rm -f "$tmp"
                return
            fi
            
            # Verify it's not too small (at least 1KB)
            local size=$(stat -f%z "$tmp" 2>/dev/null || stat -c%s "$tmp" 2>/dev/null)
            if [[ $size -lt 1000 ]]; then
                # Too small, probably corrupt
                rm -f "$tmp"
                return
            fi
            
            # Check if it's a duplicate
            cur_hash=$(sha256sum "$tmp" | awk '{print $1}')
            if [[ "$cur_hash" == "$last_stored_hash" ]]; then
                rm -f "$tmp"
                return
            fi
            
            # Store image with timestamp
            local hist_file="$HIST_DIR/$(date '+%Y%m%d_%H%M%S').png"
            mv "$tmp" "$hist_file" 2>/dev/null
            
            # Send notification with thumbnail
            notify-send --urgency=low -i "$hist_file" "$(printf '\uf0c6') clip history" 2>/dev/null || true
            
            last_stored_hash="$cur_hash"
        else
            rm -f "$tmp"
        fi
        
    else
        # Handle text
        if text=$(timeout 2 xclip -selection clipboard -o 2>/dev/null); then
            # Skip empty or very short text
            [[ -z "$text" ]] && return
            [[ ${#text} -lt 3 ]] && return
            
            # Check for duplicate
            cur_hash=$(printf "%s" "$text" | sha256sum | awk '{print $1}')
            if [[ "$cur_hash" == "$last_stored_hash" ]]; then
                return
            fi
            
            # Store in cliphist
            printf "%s" "$text" | cliphist store 2>/dev/null || true
            last_stored_hash="$cur_hash"
        fi
    fi
}

# Use clipnotify if available (event-driven)
if command -v clipnotify >/dev/null 2>&1; then
    echo "Using clipnotify (event-driven mode)" >&2
    while clipnotify 2>/dev/null; do
        store_clipboard
    done
else
    # Fallback to polling
    echo "Using polling mode (install clipnotify for better performance)" >&2
    while true; do
        store_clipboard
        sleep 0.5
    done
fi
