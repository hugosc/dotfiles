#!/bin/sh
# Apply pywal titlebar colours to the WindowMaker plist.
# Write in-place (same inode) so wmaker's inotify watch stays alive.
#
# This must be called BEFORE wmaker receives SIGUSR2 (which triggers
# "rereading defaults + reload dock"), so the plist already contains
# the correct titlebar values when wmaker repaints.

if ! pgrep -x wmaker >/dev/null 2>&1; then
    exit 0
fi

. ~/.cache/wal/colors.sh

PLIST="$HOME/GNUstep/Defaults/WindowMaker"
[ -f "$PLIST" ] || exit 1

python3 - "$PLIST" "$color0" "$color1" "$foreground" "$color8" <<'PY'
import os, re, sys

plist, c0, c1, fg, c8 = sys.argv[1:]

# Capture BEFORE the rewrite: a reader (wmaker) may have cached this value.
# We must advance strictly past BOTH it and the post-write mtime.
prev_mtime = os.stat(plist).st_mtime

with open(plist) as f:
    c = f.read()

pairs = {
    'FTitleColor':           '"' + c0 + '"',
    'FTitleBack':           '(solid, "' + c1 + '")',
    'UTitleColor':          '"' + fg + '"',
    'UTitleBack':          '(solid, "' + c0 + '")',
    'FrameFocusedBorderColor': '"' + c1 + '"',
    'FrameBorderColor':     '"' + c8 + '"',
    'FrameSelectedBorderColor': '"' + fg + '"',
}

for key, val in pairs.items():
    c = re.sub(
        r'(' + re.escape(key) + r'\s*=\s*).*',
        r'\1' + val + ';',
        c
    )

with open(plist, 'w') as f:
    f.write(c)
    f.flush()
    os.fsync(f.fileno())
PY

# Advance the plist mtime STRICTLY forward (session-monotonic). Without this
# wmaker silently ignores every re-read trigger — see wm-plist-bump.
~/.local/bin/wm-plist-bump 2>/dev/null || true


# Fallback nudge for cases where no subsequent SIGUSR2 fires (e.g.
# standalone wallpaper switches without a dockapp reload).
xdotool search --class wmaker windowactivate 2>/dev/null || true

exit 0
